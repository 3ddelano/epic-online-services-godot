// Windows version resource for the GDExtension DLL.
// Generated by SConstruct: @VERSION...@ placeholders come from plugin.cfg.
// SignPath enforces ProductName and ProductVersion when code signing.

#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION @VERSION_COMMA@
PRODUCTVERSION @VERSION_COMMA@
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS @FILEFLAGS@
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904b0"
		BEGIN
			VALUE "CompanyName", "Delano Lourenco"
			VALUE "FileDescription", "Epic Online Services Godot GDExtension"
			VALUE "FileVersion", "@VERSION@"
			VALUE "InternalName", "@INTERNAL_NAME@"
			VALUE "LegalCopyright", "Copyright (c) Delano Lourenco. MIT License."
			VALUE "OriginalFilename", "@ORIGINAL_FILENAME@"
			VALUE "ProductName", "Epic Online Services Godot"
			VALUE "ProductVersion", "@VERSION@"
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x0409, 1200
	END
END
