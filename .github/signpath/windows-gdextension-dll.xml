<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration for the Windows GDExtension binary.
  Keep in sync with the "windows-gdextension-dll" artifact configuration in SignPath.

  The GitHub Actions artifact is a zip containing exactly one libeosg.windows.*.dll
  at its root (built by this repository). Third-party DLLs (EOSSDK, xaudio2) are
  already vendor-signed and are not submitted.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="libeosg.windows.*.dll">
      <authenticode-sign/>
    </pe-file>
  </zip-file>
</artifact-configuration>
